{
  "manifest": "rp.node/v1",
  "name": "Robot gateway",
  "identity": {
    "entity": "Robie1",
    "node": "gateway"
  },
  "components": {},
  "services": {},
  "signals": {
    "routes": [
      "local",
      "mesh"
    ],
    "transports": [
      {
        "id": "mesh",
        "entry_point": "rpstack.espnow:EspNowTransport",
        "relay": true
      }
    ]
  },
  "runtime": [
    {
      "id": "wifi",
      "entry_point": "rpstack.node_runtime.network:WifiService",
      "config": {
        "ssid_env": "WIFI_SSID",
        "password_env": "WIFI_PASSWORD"
      }
    },
    {
      "id": "http",
      "entry_point": "rpstack.micropyserver:NodeRestApi"
    },
    {
      "id": "catalog",
      "entry_point": "rpstack.catalog:Catalog"
    }
  ],
  "apps": [
    {
      "id": "gateway",
      "entry_point": "rpstack.apps.robot_gateway:GatewayApp",
      "requires": [
        "http",
        "catalog"
      ]
    }
  ]
}
