{
  "manifest": "somatic.node/v1",
  "name": "Robot gateway",
  "identity": {
    "entity": "Robie1",
    "node": "gateway"
  },
  "components": {},
  "services": {},
  "signals": {
    "routes": [
      "local",
      "mesh"
    ],
    "transports": [
      {
        "id": "mesh",
        "entry_point": "somatic_mesh.espnow:EspNowTransport",
        "relay": true
      }
    ]
  },
  "runtime": [
    {
      "id": "wifi",
      "entry_point": "somatic_mesh.fabric_node.network:WifiService",
      "config": {
        "ssid_env": "WIFI_SSID",
        "password_env": "WIFI_PASSWORD"
      }
    },
    {
      "id": "http",
      "entry_point": "somatic_mesh.micropyserver:FabricRestApi"
    },
    {
      "id": "catalog",
      "entry_point": "somatic_mesh.catalog:Catalog"
    }
  ],
  "actors": [
    {
      "id": "gateway",
      "requires": [
        "http",
        "catalog"
      ],
      "behavior": "somatic_mesh.behaviors.robot_gateway:GatewayBehavior",
      "version": "0.1.0"
    }
  ]
}
