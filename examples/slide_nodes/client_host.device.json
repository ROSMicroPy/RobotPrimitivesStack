{
  "manifest": "somatic.node/v1",
  "name": "slide-client-gateway",
  "identity": {
    "entity": "SlideDemo",
    "node": "node2-host"
  },
  "components": {},
  "services": {},
  "signals": {
    "routes": [
      "local",
      "link"
    ],
    "transports": [
      {
        "id": "link",
        "entry_point": "somatic_mesh.espnow.shared:SharedEspNowTransport",
        "config": {
          "channel": 6
        }
      }
    ]
  },
  "actors": [
    {
      "id": "gateway",
      "requires": [
        "http",
        "catalog"
      ],
      "behavior": "somatic_mesh.behaviors.robot_gateway:GatewayBehavior",
      "version": "0.1.0"
    }
  ],
  "runtime": [
    {
      "id": "wifi",
      "entry_point": "somatic_mesh.fabric_node.network:WifiService",
      "config": {
        "ssid_env": "WIFI_SSID",
        "password_env": "WIFI_PASSWORD"
      }
    },
    {
      "id": "http",
      "entry_point": "somatic_mesh.micropyserver:FabricRestApi",
      "config": {
        "port": 80
      }
    },
    {
      "id": "catalog",
      "entry_point": "somatic_mesh.catalog:Catalog"
    }
  ]
}
