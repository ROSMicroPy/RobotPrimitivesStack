{
  "manifest": "somatic.node/v1",
  "name": "move-once",
  "identity": {
    "entity": "SlideDemo",
    "node": "node2"
  },
  "components": {},
  "services": {},
  "signals": {
    "routes": [
      "local",
      "link"
    ],
    "transports": [
      {
        "id": "link",
        "entry_point": "somatic_mesh.espnow.shared:SharedEspNowTransport",
        "config": {
          "channel": 6
        }
      }
    ]
  },
  "actors": [
    {
      "id": "move",
      "mode": "oneshot",
      "config": {
        "target_node": "node1",
        "position_mm": 100,
        "timeout_s": 30
      },
      "behavior": "somatic_mesh.behaviors.slide_commands:MoveOnceBehavior",
      "version": "0.1.0"
    }
  ],
  "runtime": [
    {
      "id": "catalog",
      "entry_point": "somatic_mesh.catalog:Catalog"
    }
  ]
}
