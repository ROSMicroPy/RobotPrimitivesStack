{
  "manifest": "somatic.node/v1",
  "name": "slide-ros-gateway",
  "identity": {
    "entity": "RosSlide",
    "node": "ros_gateway"
  },
  "components": {},
  "services": {},
  "execution": {
    "peers": [
      "slide_device"
    ],
    "expose": [],
    "lease_ms": 3000
  },
  "signals": {
    "routes": [
      "local",
      "ros"
    ],
    "transports": [
      {
        "id": "ros",
        "entry_point": "somatic_mesh.ros_signals:RosTransport",
        "config": {
          "backend": "rclpy"
        }
      }
    ]
  },
  "actors": [
    {
      "id": "ros",
      "config": {
        "target_node": "slide_device",
        "service": "slide",
        "namespace": "somatic_mesh/slide"
      },
      "behavior": "somatic_mesh.behaviors.ros_gateway:SlideRosBehavior",
      "version": "0.1.0"
    }
  ]
}
