{
  "manifest": "rp.node/v1",
  "name": "move-once",
  "identity": {
    "entity": "SlideDemo",
    "node": "node2"
  },
  "components": {},
  "services": {},
  "signals": {
    "routes": [
      "local",
      "link"
    ],
    "transports": [
      {
        "id": "link",
        "entry_point": "rpstack.meshnet.shared:SharedEspNowTransport",
        "config": {
          "channel": 6
        }
      }
    ]
  },
  "apps": [
    {
      "id": "move",
      "entry_point": "rpstack.linear_slide.apps:MoveOnceApp",
      "mode": "oneshot",
      "config": {
        "target_node": "node1",
        "position_mm": 100,
        "timeout_s": 30
      }
    }
  ]
}
