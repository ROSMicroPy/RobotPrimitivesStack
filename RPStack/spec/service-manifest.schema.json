{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-primitives.dev/schema/service-manifest-v1.json",
  "title": "Robot Primitive Service Manifest",
  "type": "object",
  "required": ["manifest", "service"],
  "properties": {
    "manifest": {"const": "rp.service/v1"},
    "package": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "version": {"type": ["string", "number"]},
        "import": {"type": "string"}
      },
      "additionalProperties": true
    },
    "service": {"$ref": "#/$defs/service"},
    "interfaces": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "service": {
      "type": "object",
      "required": ["name", "version", "kind", "type"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "number"]},
        "kind": {
          "enum": ["individual_driver", "adapter", "composite_driver", "runtime_service", "interface_library"]
        },
        "type": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "entry_point": {"type": "string", "pattern": "^[^:]+:[^:]+$"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "configuration": {"type": "object"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"},
        "operations": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/operation"}
        },
        "signals": {"type": "object"},
        "implementations": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/implementation"}
        },
        "tests": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/test"}
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "provides": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability"}
        },
        "requires": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/capability"}
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["interface", "version"],
      "properties": {
        "interface": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "constraints": {"type": "object"}
      },
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "configure": {"type": "string"},
        "init": {"type": "string"},
        "start": {"type": "string"},
        "stop": {"type": "string"},
        "reset": {"type": "string"},
        "status": {"type": "string"}
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {"type": "string"},
        "description": {"type": "string"},
        "arguments": {"type": "object"},
        "returns": {"type": "object"},
        "concurrency": {"enum": ["read_only", "exclusive"]},
        "cancellable": {"type": "boolean"},
        "idempotent": {"type": "boolean"},
        "safe_state": {"type": "string"}
      },
      "additionalProperties": true
    },
    "implementation": {
      "type": "object",
      "properties": {
        "entry_point": {"type": "string", "pattern": "^[^:]+:[^:]+$"},
        "description": {"type": "string"},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "configuration": {"type": "object"}
      },
      "additionalProperties": true
    },
    "test": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "description": {"type": "string"},
        "mode": {"enum": ["automatic", "manual", "hardware"]},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["operation"],
            "properties": {
              "operation": {"type": "string"},
              "arguments": {"type": "object"},
              "expect": {"type": "object"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    }
  }
}
